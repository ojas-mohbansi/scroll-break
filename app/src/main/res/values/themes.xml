<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.NoScroll" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="tintGlobalColor">#f1f1f1</item>
        <item name="globalBg">#000000</item>
        <item name="secondaryColor">#101820</item>
        <item name="switchTrack">#283039</item>
        <item name="switchThumb">#9EABB8</item>
        <item name="embeddedCards">@color/sexyGrey</item>
        <item name="glassTints">#25252E </item>
        <item name="materialAlertDialogTheme">@style/CustomMaterialAlertDialog</item>

        <!--The final colors-->
        <!-- Backgrounds -->
        <item name="colorPrimary">#1E3A8A</item>
        <item name="colorSecondary">#10B981</item>
        <item name="colorSurface">#080D14</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/inter18regular</item>
        <item name="app_bg">#000000</item>
        <item name="surface_card">#101820</item>
        <item name="surface_nested">#080D14</item>
        <item name="surface_dock">#101820</item>

        <!-- Brand -->
        <item name="brand_accent">#10B981</item>
        <item name="brand_accent_light">#34D399</item>
        <item name="brand_glow">#4D10B981</item>
        <item name="brand_tint_bg">#1A10B981</item>
        <item name="brand_tint_text">#34D399</item>

        <!-- Text -->
        <item name="text_primary">#FFFFFF</item>
        <item name="text_secondary">#99FFFFFF</item>
        <item name="text_tertiary">#80FFFFFF</item>
        <item name="text_disabled">#33FFFFFF</item>
        <item name="text_inverse">#1F2937</item>

        <!-- Glass -->
        <item name="glass_surface">#99101820</item>
        <item name="glass_stroke">#0DFFFFFF</item>
        <item name="glass_circle">#1AFFFFFF</item>

        <!-- Status: Success -->
        <item name="status_success_icon">#10B981</item>
        <item name="status_success_bg">#1A10B981</item>
        <item name="status_success_text">#34D399</item>

        <!-- Status: Warning -->
        <item name="status_warning_icon">#F59E0B</item>
        <item name="status_warning_bg">#CCF59E0B</item>
        <item name="status_warning_text">#FBBF24</item>

        <!-- Status: Error -->
        <item name="status_error_icon">#F43F5E</item>
        <item name="status_error_bg">#1AF43F5E</item>
        <item name="status_error_text">#FECDD3</item>
        <item name="critical_stroke">#33F43F5E</item>

        <!-- Status: Info -->
        <item name="status_info_icon">#3B82F6</item>
        <item name="status_info_bg">#1A3B82F6</item>
        <item name="status_info_text">#60A5FA</item>

        <!-- Charts -->
        <item name="chart_grid">#1AFFFFFF</item>
        <item name="chart_axis">#66FFFFFF</item>

        <item name="surface_dock_solid">#25252E</item> <!-- Lighter than bg -->
        <item name="dock_stroke">#33FFFFFF</item> <!-- Stronger border -->
        <item name="surface_task_solid">#101820</item> <!-- Solid Charcoal -->
        <item name="dock_item_selected_bg">#A60F0F13</item>

        <!--Settings icon bg tints-->
        <item name="eye_bg">#35262B</item>
        <item name="mobile_bg">#1D2436</item>
        <item name="browser_bg">#182A2A</item>
        <item name="block_bg">#35262B</item>
        <item name="popup_bg">#282036</item>

        <!-- Gold/Amber -->
        <item name="econ_amber_bg">#1AF59E0B</item>   <!-- 10% Amber -->
        <item name="econ_amber_text">#F59E0B</item>   <!-- Amber 500 -->

        <!-- Emerald -->
        <item name="econ_emerald_bg">#1A10B981</item> <!-- 10% Emerald -->
        <item name="econ_emerald_text">#10B981</item> <!-- Emerald 500 -->

        <!-- Timeline -->
        <item name="econ_timeline_line">#33FFFFFF</item> <!-- 20% White -->
        <item name="econ_timeline_active">#101820</item> <!-- White -->

        <!-- FIREWALL COLORS (DARK) -->
        <item name="firewall_input_bg">#141419</item>   <!-- Deep Charcoal -->
        <item name="firewall_input_text">#FFFFFF</item>
        <item name="firewall_input_hint">#33FFFFFF</item> <!-- Faded White -->

        <item name="firewall_rule_bg">#101820</item>    <!-- Lighter Charcoal -->
        <item name="firewall_rule_border">#0DFFFFFF</item> <!-- Subtle Glass -->

        <item name="firewall_chip_bg">#101820</item>
        <item name="firewall_chip_border">#1AFFFFFF</item>
        <item name="firewall_chip_text">#99FFFFFF</item>

        <item name="firewall_active_line">#FF0000</item> <!-- Neon Red -->
        <item name="sheet_input_bg">#141419</item>

        <item name="habitTileMarked">#393939</item>
        <item name="habitTileActionBtn">#0FFFFFFF</item>


    </style>

    <style name="Theme.MyApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_safe</item>
        <item name="windowSplashScreenAnimationDuration">2000</item>
        <item name="postSplashScreenTheme">@style/Theme.NoScroll</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="circleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/component_corner_radius</item>
    </style>

    <style name="NumberPickerTheme" parent="Theme.AppCompat.Light">
        <item name="colorAccent">?attr/tintGlobalColor</item>
        <item name="dividerColor">?attr/tintGlobalColor</item>
        <item name="android:fontFamily">@font/inter18regular</item>
        <item name="android:textColorPrimary">?attr/tintGlobalColor</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textSize">25sp</item>
    </style>

    <style name="Widget.App.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Switch</item>
    </style>

    <style name="ThemeOverlay.App.Switch" parent="">
        <item name="colorPrimary">@color/greenIcon</item>
        <item name="colorSurfaceVariant">@color/yellow</item>
    </style>

    <!-- Add this custom theme for the Blocking Overlay Activity -->
    <style name="Theme.ScrollBreak.TransparentOverlay" parent="Theme.NoScroll">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <!-- This will dim the background -->
        <item name="android:backgroundDimAmount">0.5</item>
        <!-- Adjust dim amount (0.0 to 1.0) -->
    </style>

    <style name="CustomTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/inter18regular</item>
        <!-- optional custom font -->
    </style>

    <style name="CustomBottomSheetTheme" parent="Theme.Material3.DayNight.BottomSheetDialog"/>

    <style name="ThemeOverlay.ScrollBreak.TimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorPrimary">@color/brainColor</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brainColor</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <!-- Unselected AM/PM chip styling -->
        <item name="colorOutline">@color/white</item>
        <item name="colorOnSurface">@color/brainColor</item>
    </style>

    <style name="AlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">?attr/surface_card</item>
        <item name="colorOnSurface">?attr/text_primary</item>
        <item name="colorOnSurfaceVariant">?attr/text_secondary</item>
        <item name="colorPrimary">@color/brainColor</item>
        <item name="shapeAppearanceOverlay">@style/CustomDialogShape</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomDialogButton</item>
    </style>

    <style name="CustomMaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">?attr/surface_card</item>
        <item name="colorOnSurface">?attr/text_primary</item>
        <item name="colorOnSurfaceVariant">?attr/text_secondary</item>
        <item name="colorPrimary">?attr/brand_accent</item>
        <item name="shapeAppearanceOverlay">@style/CustomDialogShape</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomDialogButton</item>
    </style>

    <style name="CustomDialogShape" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/component_corner_radius</item>
    </style>

    <style name="CustomDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/brand_accent</item>
    </style>

    <style name="CalendarViewCustom" parent="android:Theme.Material">
        <item name="android:colorAccent">@color/brainColor</item>
        <item name="android:textColorPrimary">?attr/tintGlobalColor</item>
        <item name="android:textColorSecondary">?attr/tintGlobalColor</item>
        <item name="android:colorBackground">?attr/secondaryColor</item>
    </style>

    <style name="SpinnerTheme" parent="android:Theme.Material">
        <item name="android:colorAccent">@color/brainColor</item>
        <item name="android:textColorPrimary">?attr/tintGlobalColor</item>
        <item name="android:textColorSecondary">?attr/tintGlobalColor</item>
        <item name="android:colorBackground">?attr/secondaryColor</item>
    </style>

    <style name="DatePickerTheme" parent="android:Theme.Material.Dialog">
        <item name="android:colorAccent">@color/brainColor</item>
        <item name="android:textColorPrimary">?attr/tintGlobalColor</item>
        <item name="android:textColorSecondary">?attr/tintGlobalColor</item>
        <item name="android:colorBackground">?attr/secondaryColor</item>
    </style>

    <style name="ShapeAppearance.CustomCardRight" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/component_corner_radius</item>
        <item name="cornerSizeTopRight">@dimen/component_corner_radius</item>
        <item name="cornerSizeBottomLeft">@dimen/component_corner_radius</item>
        <item name="cornerSizeBottomRight">@dimen/component_corner_radius</item>
        <!-- Make this corner sharp -->
    </style>

    <style name="ShapeAppearance.CustomCardLeft" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/component_corner_radius</item>
        <item name="cornerSizeTopRight">@dimen/component_corner_radius</item>
        <item name="cornerSizeBottomLeft">@dimen/component_corner_radius</item>
        <item name="cornerSizeBottomRight">@dimen/component_corner_radius</item>
        <!-- Make this corner sharp -->
    </style>

    <style name="roundImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/component_corner_radius</item>
    </style>
    <style name="PinDigitBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">numberPassword</item>
        <item name="android:maxLength">1</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/inter18regular</item>
        <item name="android:textColor">?attr/text_primary</item>
        <item name="android:background">@drawable/bg_pin_digit</item>
        <item name="android:textAlignment">center</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:cursorVisible">false</item>
    </style>

</resources>
