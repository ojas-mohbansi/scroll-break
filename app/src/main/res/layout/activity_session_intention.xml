<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Before you open"
            android:textAllCaps="true"
            android:textColor="?attr/brand_accent_light"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sessionIntentAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="?attr/text_primary"
            android:textSize="27sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="What do you want to do, and for how long?"
            android:textColor="?attr/text_tertiary"
            android:textSize="15sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="My purpose"
            android:textColorHint="?attr/text_tertiary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/sessionPurposeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="120"
                android:maxLines="2"
                android:textColor="?attr/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="How do you plan to use this session?"
            android:textColor="?attr/text_tertiary"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/sessionModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/sessionModeStandard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="General browsing or quick checks"
                android:textColor="?attr/text_primary" />

            <RadioButton
                android:id="@+id/sessionModeLongForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intentional long-form reading or viewing"
                android:textColor="?attr/text_primary" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/sessionEvaluationOptIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/session_evaluation_opt_in"
            android:textColor="?attr/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/session_evaluation_disclosure"
            android:textColor="?attr/text_tertiary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/sessionDurationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="?attr/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sessionDurationSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="Planned session length" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sessionStartButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:text="Start with intention"
            android:textAllCaps="false"
            app:backgroundTint="?attr/brand_accent"
            app:cornerRadius="@dimen/component_corner_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sessionCancelButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Not now"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/component_corner_radius" />
    </LinearLayout>
</ScrollView>
