<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="?attr/brand_tint_bg" />
            <stroke android:width="1dp" android:color="#F43F5E" />
            <corners android:radius="@dimen/component_corner_radius" />
        </shape>
    </item>
    <!-- Default State -->
    <item>
        <shape>
            <solid android:color="?attr/sheet_input_bg" />
            <stroke android:width="1dp" android:color="#0DFFFFFF" />
            <corners android:radius="@dimen/component_corner_radius" />
        </shape>
    </item>
</selector>